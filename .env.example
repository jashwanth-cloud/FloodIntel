# FloodIntel Environment Configuration Example

# Database
DB_USER=floodintel_user
DB_PASSWORD=floodintel_password
DB_NAME=floodintel_db
DB_HOST=localhost
DB_PORT=5432

# API
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# IMD API
IMD_API_BASE_URL=https://api.imd.gov.in/public
IMD_API_KEY=your_api_key_here
IMD_API_ENABLED=false
IMD_API_TIMEOUT=10
IMD_CACHE_TTL=300
